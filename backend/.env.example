# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/carelytics

# JWT secret for signing admin tokens (change in production)
JWT_SECRET=change_this_secret

# Default seed admin credentials used by seed script
SEED_ADMIN_EMAIL=admin@care.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Server port (optional)
PORT=5000
